# ---- MedFlow Backend env ----
# Copy to .env (local) and set real values in your host's dashboard (Render).

# MongoDB connection string (MongoDB Atlas)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/medflow?retryWrites=true&w=majority

# JWT signing secret — use a long random string in production.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# Frontend origin allowed by CORS (no trailing slash).
# Local: http://localhost:3000  | Prod: your Vercel URL e.g. https://medflow.vercel.app
CLIENT_URL=http://localhost:3000

# 'production' on the deployed host — enables secure + sameSite:none cookies.
NODE_ENV=development

# Port (Render/Railway inject their own; local falls back to 8000).
PORT=8000

# Server timezone — slot computation is server-local, so pin this to the
# clinic timezone or slots shift on a UTC host. e.g. Asia/Kolkata
TZ=Asia/Kolkata

# Seed admin (used once by: node src/scripts/createAdmin.js)
ADMIN_EMAIL=admin@medflow.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=MedFlow Admin
